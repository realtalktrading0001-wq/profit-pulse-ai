# ─────────────────────────────────────────────────────────────────
#  Profit Pulse AI — Environment Variables
#  Copy this file to .env and fill in your values
#  Then run:  npm install && npm start
# ─────────────────────────────────────────────────────────────────

# Step 1: Get your bot token from @BotFather on Telegram
#   → /newbot → give it a name → copy the token here
BOT_TOKEN=your_bot_token_here

# Step 2: Your deployed HTTPS URL (where this server is hosted)
#   Local dev:  use ngrok → ngrok http 3000 → copy the https URL
#   Production: Railway / Render / VPS URL
#   Example:    https://profit-pulse.railway.app
WEBAPP_URL=https://your-url-here.com

# Step 3: Server port (leave as 3000 unless your host requires a different port)
PORT=3000

# Step 4 (optional): Your Telegram numeric user ID for admin notifications
#   Find your ID by messaging @userinfobot on Telegram
#   Multiple admins: comma-separated  e.g.  123456789,987654321
ADMIN_IDS=your_telegram_user_id

# Step 5: Your Pocket Option affiliate link
#   Get this from your Pocket Option affiliate dashboard
AFFILIATE_LINK=https://u3.shortink.io/register?utm_campaign=752344&utm_source=affiliate&utm_medium=sr&a=gVM94Uu5t2L8P5&al=1739694&ac=mybot&cid=946822

# Step 6: Your Pocket Option Affiliate API key
#   Found in your PO affiliate dashboard → API / Developer settings
POCKET_OPTION_API_KEY=your_pocket_option_api_key_here
